# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash

# Line Message API
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret

# Rich Menu 語系→ID（整段 JSON；未設則讀 resources/rich_menu_ids.json）
# RICH_MENU_IDS_JSON={"zh-TW":"richmenu-xxx","en":"richmenu-yyy"}

# Line LIFF
LIFF_CHANNEL_ID = your_liff_channel_id
LIFF_CHANNEL_SECRET = your_liff_channel_secret       
LIFF_URL = your_liff_url
LIFF_ID = your_lif_id 


# 與建 Mongo 向量庫時相同（建庫若用別名請改成同一個）
EMBEDDING_MODEL=gemini-embedding-001

# Mongo / Atlas 向量
MONGODB_URI=your_mongodb_uri_here
MONGODB_DB=your_database_name
MONGODB_COLLECTION=your_collection_name
MONGODB_VECTOR_INDEX=your_vector_index_name
MONGODB_VECTOR_FIELD=embedding
MONGODB_TEXT_FIELD=text
# Atlas Search index 名稱（BM25 用；與 MONGODB_VECTOR_INDEX 不同的另一個索引）
# 建索引定義見 resources/atlas_text_search_index.json（中文必須用 lucene.cjk analyzer）
MONGODB_TEXT_INDEX=
MONGODB_VECTOR_DIM=3072

# 使用者上傳文件暫存（與官方 KB 分離；未設 collection 則關閉 ingest）
MONGODB_USER_DOCS_COLLECTION=
MONGODB_USER_DOCS_VECTOR_INDEX=
USER_DOCS_TTL_SECONDS=86400

# n8n
MEDIA_PARSE_WEBHOOK_URL=media_parse_webhook_url_here

# Public URL for LINE-accessible generated audio, e.g. https://xxx.ngrok-free.app
PUBLIC_BASE_URL=
TTS_AUDIO_URL_PATH=/tts

# n8n TTS webhook. When set, CARE calls n8n instead of local gTTS.
N8N_TTS_WEBHOOK_URL=
N8N_TTS_WEBHOOK_SECRET=
N8N_TTS_TIMEOUT_SECONDS=20
TTS_DEFAULT_VOICE=

CORS_ALLOW_ORIGINS=liff_url

# Redis 
REDIS_URL=redis://default:your_password@your_host:your_port

#自動摘要排程設定
CONSULTATION_DAILY_SUMMARY_TIME=<hour>:<minute>  # 例如：23:00

# Firecrawl（search_public_web；未設定則網路搜尋降級為無法回答）
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Cohere Rerank（未設定則以向量 score 取 top-n，不呼叫 API）
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro
RAG_RETRIEVE_CANDIDATES=40
RAG_RERANK_TOP_N=5
COHERE_RERANK_TIMEOUT_SECONDS=5
# Hybrid retrieval（向量 + BM25 以 RRF 融合）。需先建好 MONGODB_TEXT_INDEX。
# 未建索引時即使設 true 也會自動降級為純向量（$search 失敗 → fail-open）。
RAG_HYBRID_ENABLED=false
RAG_RRF_K=60
# 向量檢索最低分門檻（0.0＝不過濾，過濾交給 reranker）
RAG_VECTOR_MIN_SCORE=0.0

# Light CRAG（檢索後充足性分級；false 則略過直接生成）
RAG_CRAG_ENABLED=true
RAG_WEB_FALLBACK_ENABLED=true

# Logging（INFO 預設；DEBUG 可看 token/TTS/loading 細節）
LOG_LEVEL=INFO
