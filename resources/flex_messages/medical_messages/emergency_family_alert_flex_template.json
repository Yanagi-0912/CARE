        "size": "3xl",
        "color": "#FFFFFF",
        "wrap": true,
        "weight": "bold",
        "margin": "sm"
      }
    ]
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "paddingAll": "20px",
    "spacing": "md",
    "backgroundColor": "#FFFFFF",
    "contents": [
