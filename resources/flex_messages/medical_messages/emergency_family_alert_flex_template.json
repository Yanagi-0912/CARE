        "size": "lg",
        "color": "#111111",
        "wrap": true
      },
      {
        "type": "box",
        "layout": "vertical",
        "spacing": "sm",
        "backgroundColor": "#F5F5F5",
        "borderColor": "#DDDDDD",
        "borderWidth": "1px",
        "cornerRadius": "8px",
        "paddingAll": "16px",
        "margin": "md",
        "contents": [
          {
            "type": "text",
