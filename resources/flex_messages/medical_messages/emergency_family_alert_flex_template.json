        "borderWidth": "1px",
        "cornerRadius": "md",
        "paddingAll": "lg",
        "margin": "md",
        "action": {
          "type": "uri",
          "label": "打電話給 王小明",
          "uri": "tel:0912345678"
        },
        "contents": [
          {
            "type": "text",
            "text": "打電話給 王小明",
            "size": "xl",
            "color": "#FFFFFF",
            "wrap": true,
            "weight": "bold",
            "align": "center"
          }
        ]
