    {
      "parameters": {
        "jsCode": "const binaryData = $input.item.binary;\nconst outputItems = [];\n\nfor (const key in binaryData) {\n    if (binaryData.hasOwnProperty(key)) {\n        const file = binaryData[key];\n        const fileName = file.fileName;\n        let fileExtension = '';\n        let fileBaseName = fileName;\n\n        // 取副檔名\n        const lastDotIndex = fileName.lastIndexOf('.');\n        if (lastDotIndex !== -1 && lastDotIndex < fileName.length - 1) {\n            fileExtension = fileName.substring(lastDotIndex + 1).toLowerCase();\n            fileBaseName = fileName.substring(0, lastDotIndex);\n        }\n\n        // 將結果添加到輸出\n        outputItems.push({\n            json: {\n                originalFileName: fileName,\n                fileBaseName: fileBaseName,\n                fileExtension: fileExtension,\n            },\n            binary: { [key]: file }\n        });\n    }\n}\n\nreturn outputItems;"
      },
