    "version": "2.0"
  },
  "item": [
    {
      "name": "Multimedia Processing",
      "item": [
        {
          "name": "Test Webhook Connection",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5678/api/v1/workflows",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["api", "v1", "workflows"]
            },
            "description": "Check n8n connection and list all workflows"
          },
          "response": []
        },
        {
          "name": "Process Audio File (ASR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/your/audio.mp3",
                  "description": "Audio file: mp3, wav, m4a, flac, ogg, opus"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:5678/webhook/multimedia-process",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["webhook", "multimedia-process"]
            },
            "description": "Send audio file for ASR transcription"
          },
          "response": []
        },
        {
          "name": "Process Video File",
          "request": {
            "method": "POST",
            "header": [
              {
