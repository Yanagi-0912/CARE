              "host": ["localhost"],
              "port": "5678",
              "path": ["webhook", "multimedia-process"]
            },
            "description": "Send video file for processing"
          },
          "response": []
        },
        {
          "name": "Process Image File (OCR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/your/image.png",
                  "description": "Image file: jpg, jpeg, png, gif, bmp, tiff, webp, svg"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:5678/webhook/multimedia-process",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["webhook", "multimedia-process"]
            },
            "description": "Send image file for OCR text extraction"
