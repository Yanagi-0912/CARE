                  "description": "Document file: txt, md, csv, json, pdf, docx, xlsx, pptx, html, htm"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:5678/webhook/multimedia-process",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["webhook", "multimedia-process"]
            },
            "description": "Send document file for parsing"
          },
          "response": []
