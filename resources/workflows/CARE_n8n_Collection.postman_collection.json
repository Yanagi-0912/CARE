    {
      "name": "n8n API",
      "item": [
        {
          "name": "List All Workflows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5678/api/v1/workflows",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["api", "v1", "workflows"]
            },
            "description": "Get list of all workflows in n8n"
          },
          "response": []
        },
        {
          "name": "Get Workflow Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5678/api/v1/workflows/{{workflow_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["api", "v1", "workflows", "{{workflow_id}}"]
            },
            "description": "Get details of specific workflow (replace {{workflow_id}} with actual ID)"
          },
          "response": []
        },
        {
          "name": "List Workflow Executions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5678/api/v1/workflows/{{workflow_id}}/executions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["api", "v1", "workflows", "{{workflow_id}}", "executions"]
            },
            "description": "Get execution history for a workflow"
          },
          "response": []
        }
