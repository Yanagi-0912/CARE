    {
      "name": "TTS (Text-to-Speech)",
      "item": [
        {
          "name": "Chinese TTS - Basic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"你好，這是一個測試。\",\n  \"language\": \"zh\",\n  \"locale\": \"zh-TW\",\n  \"voice\": \"default\"\n}"
            },
            "url": {
              "raw": "http://localhost:5678/webhook/tts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["webhook", "tts"]
            },
            "description": "Convert Chinese text to speech"
          },
          "response": []
        },
        {
          "name": "Chinese TTS - With Speed & Pitch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"讀取您的設定檔，這是進階的文字轉語音測試。\",\n  \"language\": \"zh\",\n  \"locale\": \"zh-TW\",\n  \"voice\": \"default\",\n  \"speed\": 1.2,\n  \"pitch\": 1.0\n}"
            },
            "url": {
              "raw": "http://localhost:5678/webhook/tts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["webhook", "tts"]
            },
            "description": "Convert Chinese text with custom speed and pitch"
          },
          "response": []
        },
        {
          "name": "Long Text TTS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"我的家族樹和醫療記錄已安全上傳到系統。我們的應用程式提供全方位的健康管理功能，包括醫療歷史追蹤、家庭成員管理和即時健康警告。通過我們的LINE整合功能，您可以隨時隨地接收更新信息和重要提醒。\",\n  \"language\": \"zh\",\n  \"locale\": \"zh-TW\",\n  \"voice\": \"default\",\n  \"speed\": 1.0,\n  \"pitch\": 1.0\n}"
            },
            "url": {
              "raw": "http://localhost:5678/webhook/tts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5678",
              "path": ["webhook", "tts"]
            },
            "description": "Convert longer Chinese text to speech"
          },
          "response": []
        },
