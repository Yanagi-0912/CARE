    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.content.parts[0].text ?? '';\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  parsed = {\n    text: rawText,\n    languages: [],\n    primary_language: 'unknown',\n  };\n}\n\nreturn [\n  {\n    json: {\n      text: parsed.text ?? '',\n      languages: parsed.languages ?? [],\n      primary_language:\n        parsed.primary_language ?? parsed.language ?? 'unknown',\n    },\n  },\n];"
      },
