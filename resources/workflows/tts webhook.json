    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nconst text = String(body.text ?? '').trim();\nif (!text) {\n  throw new Error('Missing text');\n}\n\nconst locale = String(body.locale ?? 'zh-TW');\nconst rawLanguage = String(body.language ?? '').trim().toLowerCase();\nconst voice = body.voice || 'default';\n\nlet language = rawLanguage;\nif (!language) {\n  const normalizedLocale = locale.toLowerCase();\n  if (normalizedLocale.startsWith('zh')) {\n    language = 'zh';\n  } else if (normalizedLocale.startsWith('nan')) {\n    language = 'taiwanese';\n  } else {\n    language = 'zh';\n  }\n}\n\nlet route = 'unsupported';\nif (['zh', 'zh-tw', 'zh-hant', 'chinese', 'mandarin', '中文', '國語'].includes(language)) {\n  route = 'zh';\n}\nif (['tw', 'nan', 'taigi', 'taiwanese', '台語', '臺語'].includes(language)) {\n  route = 'taiwanese';\n}\n\nreturn [\n  {\n    json: {\n      text,\n      locale,\n      language,\n      voice,\n      route\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        160
      ],
      "id": "487711a4-bb12-4c47-8e6b-e0a9e7d23344",
      "name": "Normalize TTS Request"
    },
