    {
      "parameters": {
        "jsCode": "const MAX_TEXT_LENGTH = 5000;\nconst MIN_TEXT_LENGTH = 1;\n\nconst body = $json.body ?? $json;\n\nconst text = String(body.text ?? '').trim();\nif (!text) {\n  throw new Error('Missing text parameter');\n}\n\nif (text.length < MIN_TEXT_LENGTH) {\n  throw new Error(`Text must be at least ${MIN_TEXT_LENGTH} character(s)`);\n}\n\nif (text.length > MAX_TEXT_LENGTH) {\n  throw new Error(`Text exceeds maximum length of ${MAX_TEXT_LENGTH} characters. Current: ${text.length}`);\n}\n\nconst locale = String(body.locale ?? 'zh-TW').toLowerCase();\nconst rawLanguage = String(body.language ?? '').trim().toLowerCase();\nconst voice = body.voice || 'default';\nconst speed = body.speed ?? 1.0;\nconst pitch = body.pitch ?? 1.0;\n\nif (speed < 0.5 || speed > 2.0) {\n  throw new Error('Speed must be between 0.5 and 2.0');\n}\n\nif (pitch < 0.5 || pitch > 2.0) {\n  throw new Error('Pitch must be between 0.5 and 2.0');\n}\n\nlet language = rawLanguage;\nif (!language) {\n  const normalizedLocale = locale.toLowerCase();\n  if (normalizedLocale.startsWith('zh')) {\n    language = 'zh';\n  } else if (normalizedLocale.startsWith('nan')) {\n    language = 'taiwanese';\n  } else {\n    language = 'zh';\n  }\n}\n\nlet route = 'unsupported';\nif (['zh', 'zh-tw', 'zh-hant', 'chinese', 'mandarin', '中文', '國語'].includes(language)) {\n  route = 'zh';\n}\nif (['tw', 'nan', 'taigi', 'taiwanese', '台語', '臺語'].includes(language)) {\n  route = 'taiwanese';\n}\n\nreturn [{\n  json: {\n    text,\n    textLength: text.length,\n    locale,\n    language,\n    voice,\n    speed,\n    pitch,\n    route,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
